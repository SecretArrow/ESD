// Eclipse SSH Desktop - Windows version resource (configured by CMake).
// Gives the executable a real identity: description, version, publisher and
// the application icon. Without this, Explorer/SmartScreen/antivirus see an
// anonymous exe with blank metadata, which maximizes false-positive suspicion.
#include <windows.h>

1 ICON "@ESD_ICON_RC_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Eclipse SSH Desktop Project"
            VALUE "FileDescription",  "Eclipse SSH Desktop - SSH/SFTP client"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "eclipse-ssh-desktop"
            VALUE "LegalCopyright",   "MIT License - Eclipse SSH Desktop contributors"
            VALUE "OriginalFilename", "eclipse-ssh-desktop.exe"
            VALUE "ProductName",      "Eclipse SSH Desktop"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

[
  {
    "name": "prod-web-1",
    "group": "Production",
    "tags": ["web", "nginx"],
    "favorite": true,
    "host": "10.0.0.11",
    "port": 22,
    "username": "deploy",
    "authMethod": "publickey",
    "privateKeyPath": "~/.ssh/id_ed25519",
    "engine": "auto",
    "extra": {
      "jumpHosts": ["bastion"],
      "keepAliveSeconds": 15,
      "compression": false,
      "connectTimeoutMs": 15000,
      "autoReconnect": true,
      "startupCommands": ["cd /srv/app && tail -f log/production.log"],
      "sftpDefaultRemoteDir": "/srv/app",
      "transferProtocol": "sftp",
      "forwardingRules": [
        {
          "id": "r1",
          "name": "Postgres",
          "type": "local",
          "listenAddress": "127.0.0.1",
          "listenPort": 5432,
          "destHost": "db.internal",
          "destPort": 5432,
          "autoStart": true,
          "enabled": true
        }
      ],
      "environment": ["APP_ENV=production"]
    }
  },
  {
    "name": "bastion",
    "group": "Production",
    "host": "jump.example.com",
    "port": 22,
    "username": "ops",
    "authMethod": "agent",
    "engine": "auto"
  },
  {
    "name": "docker-host",
    "group": "Staging",
    "tags": ["docker"],
    "host": "192.168.10.40",
    "port": 22,
    "username": "ubuntu",
    "authMethod": "password",
    "engine": "libssh2",
    "extra": {
      "forwardingRules": [
        { "id": "r2", "name": "SOCKS proxy", "type": "dynamic",
          "listenAddress": "127.0.0.1", "listenPort": 1080,
          "autoStart": false, "enabled": true }
      ]
    }
  }
]
